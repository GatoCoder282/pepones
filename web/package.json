{
  "name": "pepones-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/content.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/content.mjs && next build",
    "content:sync": "node scripts/content.mjs --sync",
    "typecheck": "tsc --noEmit",
    "check:domain": "node scripts/check-domain.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "start": "serve out -l 3000"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.9",
    "serve": "^14.2.4",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0"
  }
}
